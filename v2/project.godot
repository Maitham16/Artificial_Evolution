; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Artificial Evolution 2.0"
config/version="2.0.0"
run/main_scene="res://scenes/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="ArtificialEvolution2"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]

window/size/viewport_width=1520
window/size/viewport_height=960
window/size/window_width_override=1520
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/size/min_width=1160
window/size/min_height=760

[filesystem]

import/blender/enabled=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2

[shader_globals]

eco_time={
"type": "float",
"value": 0.0
}
eco_wind={
"type": "float",
"value": 1.0
}
eco_tint={
"type": "color",
"value": Color(1, 1, 1, 1)
}
eco_snow={
"type": "float",
"value": 0.0
}
eco_wetness={
"type": "float",
"value": 0.0
}
eco_daylight={
"type": "float",
"value": 1.0
}
